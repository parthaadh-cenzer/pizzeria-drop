{
  "name": "pizseria-drop",
  "version": "1.0.0",
  "description": "Pizzeria Drop: modular 3D asset foundation and local browser art/playtest studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "assets": "node scripts/build-assets.mjs",
    "test": "node scripts/test-gameplay.mjs && node scripts/test-server.mjs && node scripts/validate.mjs",
    "test:browser": "node scripts/acceptance-browser.mjs && node scripts/acceptance-rocket.mjs && node scripts/acceptance-winner.mjs",
    "capture": "node scripts/capture.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:rocket": "node scripts/acceptance-rocket.mjs",
    "test:winner": "node scripts/acceptance-winner.mjs",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "test:multiplayer": "node scripts/acceptance-multiplayer.mjs",
    "test:webkit": "node scripts/acceptance-webkit.mjs",
    "test:load": "node scripts/load-test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test:production": "node scripts/acceptance-production.mjs"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "vite": "^8.3.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=20.19"
  }
}
